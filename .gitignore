# OS and editor noise
.DS_Store
.idea/
.vscode/
.claude/

# Python caches and local runtimes
**/__pycache__/
**/*.pyc
**/.venv/
**/.pytest_cache/

# Local environment and secrets
**/.env
**/.env.*
**/.asr_env
**/keys/adbkey
**/keys/adbkey.pub
.worktrees/

# Local output and logs
*.log
**/*.log
tmp/
dist/

# Unfinished skills kept locally in the repository workspace
/drafts/*
!/drafts/.gitkeep

# Completed but non-redistributable skills kept locally in the workspace
/restricted/

# Local third-party skill sources and copied references
/third_party/*
!/third_party/README.md
!/third_party/repos/
!/third_party/repos/.gitkeep
!/third_party/imports/
!/third_party/imports/.gitkeep
/third_party/repos/*
!/third_party/repos/.gitkeep
/third_party/imports/*
!/third_party/imports/.gitkeep

# Ignore everything under docs by default
/docs/*

# But keep references publishable
!/docs/references/
!/docs/references/**

# Local reference copies of external authoring guides
/docs/references/skill-authoring/The-Complete-Guide-to-Building-Skill-for-Claude.md
/docs/references/skill-authoring/assets/The-Complete-Guide-to-Building-Skill-for-Claude.pdf
.omx/
