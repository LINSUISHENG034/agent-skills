# Copy this file to .env for local-only testing.
# The skill loads <skill-root>/.env automatically.

NODE_WHISPER_REMOTE_USER=your-windows-ssh-user
NODE_WHISPER_REMOTE_HOST=192.168.0.100
NODE_WHISPER_SSH_KEY=/home/you/.ssh/node_whisper_win
NODE_WHISPER_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... your-label
NODE_WHISPER_RUNTIME_DIR=E:/Projects/node-whisper-runtime
NODE_WHISPER_TRANSPORT=ssh
NODE_WHISPER_NODE_NAME=

# Optional explicit local fallback provider settings.
# Fallback is never automatic; the caller must pass --fallback-provider.
#
# First provider: http-generic
# NODE_WHISPER_FALLBACK_HTTP_URL=https://example.invalid/transcriptions
# NODE_WHISPER_FALLBACK_HTTP_HEADERS_JSON={"Authorization":"Bearer <token>"}
# NODE_WHISPER_FALLBACK_HTTP_EXTRA_FORM_JSON={"model":"asr-1"}
# NODE_WHISPER_FALLBACK_HTTP_FILE_FIELD=file
# NODE_WHISPER_FALLBACK_HTTP_TEXT_FIELD=text
# NODE_WHISPER_FALLBACK_HTTP_LANGUAGE_FIELD=language
